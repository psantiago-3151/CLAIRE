# Copy to claire.conf (gitignored) and edit.
# Env vars CLAIRE_* override these.
# Paths may be relative to the project root.
#
# These names are examples only. Swap the Ollama model, Piper .onnx, and
# Whisper ggml file after you download them. CLAIRE only lists what is
# already on disk / in Ollama; it does not guarantee any given combo.

# Ollama model
llm_model=qwen2.5:7b

# Hugging Face Piper voice (rhasspy/piper-voices)
voice_model=models/piper/en_US-libritts_r-medium.onnx
voice_speaker=0

whisper_bin=bin/whisper-cli
whisper_model=models/whisper/ggml-base.en.bin
piper_bin=venv/bin/piper
memory_dir=memory
# Linux arecord device: default, pulse, plughw:1,0. Empty = auto.
mic_device=

# Filler speech while waiting on the model (repeats this often)
thinking_interval_secs=5
# Silence inserted before the wake word in missing-wake replies
name_breath_secs=0.35
# 0 = original equal pick; 50 = preferred ~2×; 100 = preferred only
phrase_select_mode=flat
preferred_boost_pct=0
wake_fuzz_threshold=85

# Wake word (matched anywhere in the transcript)
wake_word=claire

# Keyboard names for python src/comms.py
run_key=space
record_key=tab
interrupt_key=f12
quit_key=esc

# Spoken runtime commands (comma-separated; new session requires the phrase twice)
quit_phrases=exit,goodbye,shut down,shutdown
new_session_phrase=scratch that
