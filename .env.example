# Copy to .env (gitignored). These override jarvis.conf when set.
# Do not commit .env, jarvis.conf, memory/, or model binaries.

# --- UI ---
# Bind localhost only unless you understand the risk (mic + Start/Stop on the LAN).
JARVIS_UI_HOST=127.0.0.1
JARVIS_UI_PORT=8742

# --- Ollama ---
# Must match `ollama serve`. The Python client also reads OLLAMA_HOST.
OLLAMA_HOST=http://127.0.0.1:11434
# JARVIS_LLM_MODEL=qwen2.5:7b

# --- Optional overrides (same keys as jarvis.conf) ---
# JARVIS_WAKE_WORD=friday
# JARVIS_VOICE_MODEL=models/piper/en_US-libritts_r-medium.onnx
# JARVIS_VOICE_SPEAKER=0
# JARVIS_WHISPER_BIN=bin/whisper-cli
# JARVIS_WHISPER_MODEL=models/whisper/ggml-base.en.bin
# JARVIS_PIPER_BIN=venv/bin/piper
# JARVIS_MEMORY_DIR=memory
# JARVIS_MIC_DEVICE=
# JARVIS_THINKING_INTERVAL_SECS=5
# JARVIS_NAME_BREATH_SECS=0.35
# JARVIS_PREFERRED_BOOST=0
# JARVIS_PHRASE_MODE=flat
# JARVIS_RECORD_KEY=tab
# JARVIS_INTERRUPT_KEY=f12
# JARVIS_QUIT_KEY=esc
# JARVIS_QUIT_PHRASES=exit,goodbye,shut down
# JARVIS_NEW_SESSION_PHRASE=scratch that
