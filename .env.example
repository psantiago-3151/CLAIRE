# Copy to .env (gitignored). These override claire.conf when set.
# Do not commit .env, claire.conf, memory/, or model binaries.
# CLAIRE_* overrides claire.conf. Do not commit this file.

# --- UI ---
# Bind localhost only unless you understand the risk (mic + Start/Stop on the LAN).
CLAIRE_UI_HOST=127.0.0.1
CLAIRE_UI_PORT=8742

# --- Ollama ---
OLLAMA_HOST=http://127.0.0.1:11434
# CLAIRE_LLM_MODEL=qwen2.5:7b

